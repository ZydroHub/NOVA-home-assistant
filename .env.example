PORT=8000
# Keep the backend local to the Pi/desktop unless you add an authenticated proxy.
NOVA_BIND_HOST=127.0.0.1
# NOVA_PROJECT_ROOT=$HOME/NOVA
# NOVA_ENV_PATH=$HOME/NOVA/.env

# Runtime data files. Keep these out of git; override for tests or deployments.
# CONVERSATIONS_FILE=$HOME/NOVA/conversations.json
# JOBS_FILE=$HOME/NOVA/task_jobs.json
# TELEGRAM_SEEN_ALERTS_FILE=$HOME/NOVA/telegram_seen_alerts.json
# TELEGRAM_SUBSCRIPTIONS_FILE=$HOME/NOVA/telegram_subscriptions.json
# ALERT_SETTINGS_FILE=$HOME/NOVA/alert_settings.json

# Models and tools.
# LOCAL_DIR=$HOME/NOVA/models
# TOOLS_PATH=$HOME/NOVA/tools.json
# VOSK_MODEL_PATH=$HOME/NOVA/models/vosk/vosk-model-small-en-us-0.15
# WHISPER_VOCABULARY_PATH=$HOME/NOVA/vocabulary.txt
# WHISPER_MODEL_SIZE=base
# WHISPER_LANGUAGE=en
# For English-only speech on weak hardware, tiny.en is faster but less accurate.
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_VAD_FILTER=true
# WHISPER_WITHOUT_TIMESTAMPS=true
# WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# CORS. Comma-separated exact origins; no wildcard default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# CORS_ALLOWED_ORIGIN_REGEX=

# Frontend/backend wiring.
VITE_API_HOST=127.0.0.1
VITE_API_PORT=8000
VITE_DEV_PORT=5173

# Optional integrations.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
NOVA_AUDIO_SOURCE=spotify
# TELEGRAM_BOT_TOKEN=

# Local hardware controls.
# NOVA_AUDIO_RELEASE_COMMANDS=
# NOVA_LLM_THREADS=4
# NOVA_TOOL_LLM_THREADS=4
# NOVA_CODE_LLM_THREADS=4
# NOVA_VOICE_SYSTEM_PROMPT=
